{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ORYNTH-systems/aoms-reference-runtime/schemas/AOMS_DOMAIN_EXECUTION_CASE_SCHEMA.json",
  "title": "AOMS Domain Execution Case",
  "type": "object",
  "required": ["schema_version", "case_id", "domain", "effect_class", "artifact", "context", "expected"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "case_id": {"pattern": "^AOMS-B06-[0-9]{3}$"},
    "domain": {"enum": ["AI_AGENTS", "FINANCE", "HEALTHCARE", "ROBOTICS", "CIVIC_SYSTEMS", "EMERGENCY_RESPONSE"]},
    "effect_class": {"type": "string", "minLength": 1},
    "artifact": {"type": "object"},
    "context": {"type": "object"},
    "expected": {
      "type": "object",
      "required": ["decision", "terminal", "required_reasons", "proof_complete"],
      "properties": {
        "decision": {"enum": ["ALLOW", "DENY", "ESCALATE", "REAUTHORIZE"]},
        "terminal": {"const": true},
        "required_reasons": {"type": "array", "items": {"type": "string"}},
        "proof_complete": {"const": true}
      }
    }
  }
}
